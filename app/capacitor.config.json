{
  "appId": "co.gam.planetrush",
  "appName": "Planet Rush",
  "webDir": "www",
  "backgroundColor": "#05060f",
  "android": { "backgroundColor": "#05060f", "allowMixedContent": false },
  "ios": { "backgroundColor": "#05060f", "contentInset": "never", "scrollEnabled": false },
